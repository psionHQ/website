# Environment Variables

# ─────────────────────────────────────────────────────────────────────────────
# PSIONHQ Website — Environment Variable Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real secrets.
# .env.local is listed in .gitignore.
#
# For production, configure these variables in your hosting platform
# (e.g. Vercel environment settings).
# ─────────────────────────────────────────────────────────────────────────────


# ─── Application ──────────────────────────────────────────────────────────────

# The canonical URL of the site. Used for sitemap generation, OG metadata,
# and canonical link generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─── Authentication ───────────────────────────────────────────────────────────
# Authentication is not yet implemented. These variables are reserved for
# the upcoming auth provider integration (Phase 3).

# Auth provider secret — used to sign sessions and tokens.
# Generate a secure random value: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (required for "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (required for "Continue with GitHub")
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ─── Email / Transactional ────────────────────────────────────────────────────
# Used for contact form submissions and newsletter subscriptions.
# Not yet implemented — reserved for Phase 2 backend integration.

# Email delivery service API key (e.g. Resend, SendGrid, Postmark)
EMAIL_API_KEY=

# Address that form submissions and contact requests are sent to
EMAIL_TO=

# Address used as the sender for outbound emails
EMAIL_FROM=


# ─── Analytics ────────────────────────────────────────────────────────────────
# Not yet implemented — reserved for future integration.

# Analytics measurement ID (e.g. Google Analytics G-XXXXXXXXXX)
NEXT_PUBLIC_ANALYTICS_ID=


# ─── Feature Flags ────────────────────────────────────────────────────────────
# Not yet implemented.

# Enable the blog newsletter signup form backend
NEXT_PUBLIC_NEWSLETTER_ENABLED=false

# Enable the contact form backend
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false
