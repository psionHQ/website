# Environment Variables

# ─────────────────────────────────────────────────────────────────────────────
# PSIONHQ Website — Environment Variable Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real secrets.
# .env.local is listed in .gitignore.
#
# For production, configure these variables in your hosting platform
# (e.g. Vercel environment settings).
# ─────────────────────────────────────────────────────────────────────────────


# ─── Application ──────────────────────────────────────────────────────────────

# The canonical URL of the site. Used for sitemap generation, OG metadata,
# and canonical link generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL for API requests.
# Defaults to ${NEXT_PUBLIC_SITE_URL}/api when not provided.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api


# ─── Authentication (Clerk) ───────────────────────────────────────────────────
# Authentication is powered by Clerk.
# Sign up at https://clerk.com and create an application to get your keys.
#
# Setup steps:
#   1. Create a Clerk application at https://dashboard.clerk.com
#   2. Enable Email/Password, Google, and GitHub in Clerk Dashboard → User & Authentication
#   3. For Google OAuth: create credentials at https://console.cloud.google.com
#      and add them to Clerk Dashboard → Social connections → Google
#   4. For GitHub OAuth: create an OAuth App at https://github.com/settings/developers
#      and add the credentials to Clerk Dashboard → Social connections → GitHub
#   5. Set NEXT_PUBLIC_AUTH_PROVIDER=clerk below
#   6. Copy your Clerk keys from the Dashboard → API Keys section

# Which auth provider the app uses:
# - none   (default, disables auth)
# - clerk  (production)
NEXT_PUBLIC_AUTH_PROVIDER=clerk

# Clerk publishable key (safe to expose publicly)
# Starts with pk_test_ or pk_live_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key (keep private — never expose in client-side code)
# Starts with sk_test_ or sk_live_
CLERK_SECRET_KEY=


# ─── Database (Reserved Architecture) ─────────────────────────────────────────
# Database is not implemented yet.
# This value is reserved for the upcoming data layer integration.
DATABASE_URL=


# ─── Email / Transactional ────────────────────────────────────────────────────
# Used for contact form submissions and newsletter subscriptions.
# Backend delivery is not implemented yet.

# Email delivery service API key (e.g. Resend, SendGrid, Postmark)
EMAIL_API_KEY=

# Address that form submissions and contact requests are sent to
EMAIL_TO=

# Address used as the sender for outbound emails
EMAIL_FROM=


# ─── Analytics ────────────────────────────────────────────────────────────────
# Not yet implemented — reserved for future integration.

# Analytics measurement ID (e.g. Google Analytics G-XXXXXXXXXX)
NEXT_PUBLIC_ANALYTICS_ID=


# ─── Feature Flags ────────────────────────────────────────────────────────────

# Enable the blog newsletter signup form backend
NEXT_PUBLIC_NEWSLETTER_ENABLED=false

# Enable the contact form backend
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false
