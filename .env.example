# Environment Variables

# ─────────────────────────────────────────────────────────────────────────────
# PSIONHQ Website — Environment Variable Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real secrets.
# .env.local is listed in .gitignore.
#
# For production, configure these variables in your hosting platform
# (e.g. Vercel environment settings).
# ─────────────────────────────────────────────────────────────────────────────


# ─── Application ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api


# ─── Authentication — Clerk ───────────────────────────────────────────────────

# Supported providers:
# - none
# - clerk
# - authjs

NEXT_PUBLIC_AUTH_PROVIDER=clerk

# Clerk publishable key.
# Safe to expose publicly.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key.
# NEVER expose this through NEXT_PUBLIC_*.
CLERK_SECRET_KEY=

# Reserved application authentication secret.
# Server-side only.
AUTH_SECRET=


# ─── Database ─────────────────────────────────────────────────────────────────

# Legacy database connection.
# Kept temporarily for compatibility with the existing DatabaseClient.
# Server-side only.
DATABASE_URL=


# ─── Supabase ─────────────────────────────────────────────────────────────────

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key.
# Safe to expose publicly when Row Level Security is configured correctly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ─── AI ───────────────────────────────────────────────────────────────────────

# Anthropic API key.
# Server-side only.
ANTHROPIC_API_KEY=


# ─── Encryption ───────────────────────────────────────────────────────────────

# Server-side only.
#
# This is the current configuration entry point for PsionHQ's
# encryption layer.
#
# NEVER expose this through NEXT_PUBLIC_*.
#
# This is NOT the final production key-management architecture.
ENCRYPTION_KEY=


# ─── Email / Transactional ────────────────────────────────────────────────────

# Reserved for future email delivery integration.
EMAIL_API_KEY=

EMAIL_TO=

EMAIL_FROM=


# ─── Analytics ────────────────────────────────────────────────────────────────

# Analytics measurement ID.
NEXT_PUBLIC_ANALYTICS_ID=


# ─── Feature Flags ────────────────────────────────────────────────────────────

NEXT_PUBLIC_NEWSLETTER_ENABLED=false

NEXT_PUBLIC_CONTACT_FORM_ENABLED=false